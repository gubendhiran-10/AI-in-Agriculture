# ═══ KrishiAI Environment Variables ═══

# Python Version for Render deployment
PYTHON_VERSION=3.11.0

# Server Port (Render provides this automatically, default is 5000)
PORT=5000

# Database Configuration
# If you have MongoDB Atlas (Cloud), paste your URI below:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=AI_in_Agriculture_Emergency_Resource_Allocation

# Optional Google Sign-In Client ID
GOOGLE_CLIENT_ID=
